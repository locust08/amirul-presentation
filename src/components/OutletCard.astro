---
import { directionsUrl, mapEmbedUrl, telHref, whatsappHref, type Outlet } from "../lib/content";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
	outlet: Outlet;
	lang: Lang;
	/** Show an embedded Google Map (lazy-loaded). */
	map?: boolean;
	/** Restaurant name shown above the outlet name (contact page). */
	restaurant?: { name: string; href: string };
	headingLevel?: "h2" | "h3";
}

const { outlet, lang, map = false, restaurant, headingLevel = "h3" } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
---

<section class:list={["outlet", { "with-map": map }]} aria-label={outlet.name}>
	<div class="details">
		{
			restaurant && (
				<p class="restaurant">
					<a href={restaurant.href}>{restaurant.name}</a>
				</p>
			)
		}
		<Heading class="name">{outlet.name}</Heading>
		<dl>
			{
				outlet.address && (
					<div>
						<dt>{t("restaurants.address")}</dt>
						<dd>
							<a href={directionsUrl(outlet)} target="_blank" rel="noopener noreferrer">
								{outlet.address}
							</a>
						</dd>
					</div>
				)
			}
			{
				outlet.hours && (
					<div>
						<dt>{t("restaurants.hours")}</dt>
						<dd class="pre">{outlet.hours}</dd>
					</div>
				)
			}
			{
				outlet.phone && (
					<div>
						<dt>{t("restaurants.phone")}</dt>
						<dd>
							<a href={telHref(outlet.phone)}>{outlet.phone}</a>
						</dd>
					</div>
				)
			}
		</dl>
		<div class="actions">
			<a class="btn btn-red" href={directionsUrl(outlet)} target="_blank" rel="noopener noreferrer">
				{t("restaurants.directions")}
			</a>
			{
				outlet.whatsapp && (
					<a class="btn btn-line" href={whatsappHref(outlet.whatsapp)} target="_blank" rel="noopener noreferrer">
						{t("restaurants.whatsapp")}
					</a>
				)
			}
		</div>
	</div>
	{
		map && (
			<div class="map">
				<iframe
					title={`${t("restaurants.mapTitle")} ${outlet.name}`}
					src={mapEmbedUrl(outlet, lang)}
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allowfullscreen
				/>
			</div>
		)
	}
</section>

<style>
	.outlet {
		display: grid;
		gap: var(--space-3);
		background: var(--white);
		border-radius: var(--radius);
		padding: var(--space-3);
		color: var(--ink);
	}

	.with-map {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		align-items: stretch;
	}

	.restaurant {
		margin: 0 0 0.2rem;
		font-weight: 700;
		color: var(--red);
	}
	.restaurant a {
		text-decoration: none;
	}
	.restaurant a:hover {
		text-decoration: underline;
	}

	.name {
		font-size: var(--step-1);
		margin-bottom: var(--space-2);
	}

	dl {
		display: grid;
		gap: 0.8rem;
		margin: 0 0 var(--space-3);
	}

	dt {
		font-size: var(--step--1);
		font-weight: 700;
		color: var(--ink-soft);
	}

	dd {
		margin: 0;
	}

	.pre {
		white-space: pre-line;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.actions .btn-line {
		color: var(--ink);
	}

	.map {
		min-height: 260px;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--jade-soft);
	}

	.map iframe {
		width: 100%;
		height: 100%;
		min-height: 260px;
		border: 0;
		display: block;
	}

	@media (max-width: 760px) {
		.with-map {
			grid-template-columns: 1fr;
		}
	}
</style>
