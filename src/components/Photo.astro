---
/**
 * Shows a CMS image, or — until the team uploads photography — a menu-card
 * placeholder lettered with the dish or restaurant name.
 */
import { Image } from "emdash/ui";
import { hasImage, type Accent } from "../lib/content";

interface Props {
	image?: unknown;
	alt?: string;
	/** Large lettering for the placeholder (usually the Chinese name). */
	han?: string;
	/** Small text under the placeholder lettering. */
	caption?: string;
	accent?: Accent;
	ratio?: string;
	sizes?: string;
	loading?: "eager" | "lazy";
	class?: string;
}

const {
	image,
	alt = "",
	han,
	caption,
	accent = "red",
	ratio = "4 / 3",
	sizes = "(min-width: 900px) 33vw, 100vw",
	loading = "lazy",
	class: className,
} = Astro.props;
const showImage = hasImage(image);
const img = image as any;
---

<div class:list={["photo", `photo-${accent}`, className]} style={`aspect-ratio: ${ratio}`}>
	{
		showImage ? (
			<Image image={img} alt={img?.alt || alt} sizes={sizes} loading={loading} />
		) : (
			<div class="placeholder" role="img" aria-label={alt || caption || han}>
				{han && (
					<span class="ph-han han" lang="zh-Hans">
						{han}
					</span>
				)}
				{caption && <span class="ph-caption">{caption}</span>}
			</div>
		)
	}
</div>

<style>
	.photo {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--jade);
	}

	.photo :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 1rem;
		text-align: center;
		background: var(--ph-bg, var(--red));
		background-image: var(--tile);
		color: var(--ph-fg, var(--gold));
	}

	.ph-han {
		font-size: clamp(1.6rem, 1rem + 2.5vw, 2.6rem);
		line-height: 1.15;
	}

	.ph-caption {
		font-size: var(--step--1);
		font-weight: 600;
		opacity: 0.9;
		max-width: 22ch;
	}

	.photo-red {
		--ph-bg: var(--red);
		--ph-fg: var(--gold);
	}
	.photo-gold {
		--ph-bg: var(--gold);
		--ph-fg: var(--red-deep);
	}
	.photo-gold .placeholder {
		background-image:
			linear-gradient(rgb(0 0 0 / 0.06) 1px, transparent 1px) 0 0 / 18px 18px,
			linear-gradient(90deg, rgb(0 0 0 / 0.06) 1px, transparent 1px) 0 0 / 18px 18px;
	}
	.photo-neon {
		--ph-bg: var(--night);
		--ph-fg: #ffe3ef;
	}
	.photo-neon .ph-han {
		text-shadow:
			0 0 4px var(--neon),
			0 0 16px var(--neon);
	}
	.photo-jade {
		--ph-bg: var(--jade);
		--ph-fg: var(--white);
	}
</style>
