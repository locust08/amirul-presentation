---
/**
 * Homepage hero: headline, intro, two buttons and the row of hanging
 * restaurant signboards. The background photo comes from the CMS
 * (Pages → home → Main photo) and can be swapped by clicking it in edit mode.
 */
import { Image } from "emdash/ui";
import Signboard from "../Signboard.astro";
import { accentOf, getLocalizedEntry, getRestaurants, hasImage } from "../../lib/content";
import { localePath, type Lang } from "../../i18n/ui";

interface Props {
	lang: Lang;
	/** Main headline */
	heading: string;
	/** Text under the headline */
	lede?: string;
	/** Gold button label */
	primaryLabel?: string;
	/** Gold button link (path without the /zh prefix) */
	primaryHref?: string;
	/** Outline button label */
	secondaryLabel?: string;
	/** Outline button link (path without the /zh prefix) */
	secondaryHref?: string;
}

const {
	lang,
	heading,
	lede,
	primaryLabel,
	primaryHref = "/restaurants",
	secondaryLabel,
	secondaryHref = "/contact",
} = Astro.props;

const [restaurants, homePage] = await Promise.all([
	getRestaurants(lang, Astro),
	getLocalizedEntry("pages", "home", lang, Astro),
]);
const heroImage = homePage?.data.hero_image;
---

<section class="hero on-jade">
	{
		hasImage(heroImage) && (
			<div class="hero-photo" {...homePage?.edit?.hero_image}>
				<Image image={heroImage as any} alt="" sizes="100vw" loading="eager" fetchpriority="high" />
			</div>
		)
	}
	<div class="wrap hero-grid">
		<div class="hero-copy">
			<h1>{heading}</h1>
			{lede && <p class="lede">{lede}</p>}
			<div class="hero-actions">
				{primaryLabel && <a class="btn btn-gold" href={localePath(lang, primaryHref)}>{primaryLabel}</a>}
				{secondaryLabel && <a class="btn btn-line" href={localePath(lang, secondaryHref)}>{secondaryLabel}</a>}
			</div>
		</div>

		<ul class="street" aria-label={lang === "zh" ? "餐厅" : "Restaurants"}>
			{
				restaurants.map((r, i) => (
					<li style={`--i:${i}`}>
						<a href={localePath(lang, `/restaurants/${r.id}`)} aria-label={r.data.name}>
							<Signboard text={r.data.name_zh} accent={accentOf(r)} size={i === 0 ? "lg" : "md"} />
							{r.data.name !== r.data.name_zh && <span class="street-label">{r.data.name}</span>}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: var(--space-5) 0;
	}

	.hero-photo {
		position: absolute;
		inset: 0;
	}
	.hero-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.35;
	}

	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: var(--space-4);
		align-items: start;
	}

	.hero-copy {
		padding-bottom: var(--space-5);
	}

	.hero h1 {
		max-width: 14ch;
		margin-bottom: var(--space-3);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-3);
	}

	/* A row of signboards hanging from a rail, like a Hong Kong street */
	.street {
		position: relative;
		display: flex;
		justify-content: flex-end;
		align-items: flex-start;
		gap: clamp(1rem, 3vw, 2.5rem);
		margin: calc(-1 * var(--space-5)) 0 0;
		padding: 0 0 var(--space-4);
		list-style: none;
		align-self: stretch;
	}

	.street::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: calc(-1 * var(--gutter));
		height: 10px;
		background: var(--jade-deep);
		border-bottom: 2px solid rgb(0 0 0 / 0.25);
	}

	.street li {
		position: relative;
		padding-top: calc(2.2rem + var(--i) * 2.4rem);
		transform-origin: top center;
		animation: hang 1.6s cubic-bezier(0.3, 1.6, 0.5, 1) both;
		animation-delay: calc(0.15s + var(--i) * 0.12s);
	}

	/* Brackets holding each sign */
	.street li::before {
		content: "";
		position: absolute;
		top: 8px;
		left: 50%;
		width: 3px;
		height: calc(2.2rem + var(--i) * 2.4rem - 8px);
		background: linear-gradient(var(--gold-deep), #6b4a08);
		transform: translateX(-50%);
	}

	.street a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
	}

	.street a:hover :global(.sign) {
		filter: brightness(1.12);
	}

	.street-label {
		font-size: var(--step--1);
		font-weight: 700;
		text-align: center;
		max-width: 10ch;
		line-height: 1.25;
	}

	@keyframes hang {
		0% {
			transform: rotate(-7deg);
			opacity: 0;
		}
		25% {
			opacity: 1;
		}
		100% {
			transform: rotate(0);
		}
	}

	@media (max-width: 860px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.hero-copy {
			padding-bottom: var(--space-4);
		}

		.street {
			order: -1;
			justify-content: flex-start;
			margin: calc(-1 * var(--space-5)) calc(-1 * var(--gutter)) var(--space-3);
			padding-inline: var(--gutter);
			padding-bottom: 0;
			overflow-x: auto;
		}

		.street::before {
			left: 0;
			right: 0;
		}

		.street li {
			padding-top: calc(1.4rem + var(--i) * 1rem);
		}
		.street li::before {
			height: calc(1.4rem + var(--i) * 1rem - 8px);
		}
	}
</style>
