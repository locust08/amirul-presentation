---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import RestaurantGrid from "../components/sections/RestaurantGrid.astro";

Astro.response.status = 404;
// Unknown /zh/... addresses land here too: answer them in Chinese.
const zh = /^\/zh(\/|$)/.test(Astro.url.pathname);
---

{
	zh ? (
		<Base lang="zh" title="找不到页面" noindex alternates={false}>
			<PageHeader lang="zh" plain heading="找不到页面" lede="此页面不存在或已移动。不如看看我们的餐厅？" buttonLabel="返回首页" buttonHref="/" />
			<RestaurantGrid lang="zh" cardHeadings="h2" />
		</Base>
	) : (
		<Base lang="en" title="Page not found" noindex alternates={false}>
			<PageHeader
				lang="en"
				plain
				heading="Page not found"
				lede="This page doesn’t exist or has moved. Try one of our restaurants instead."
				buttonLabel="Go to the homepage"
				buttonHref="/"
			/>
			<RestaurantGrid lang="en" cardHeadings="h2" />
		</Base>
	)
}
