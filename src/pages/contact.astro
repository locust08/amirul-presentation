---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import Locations from "../components/sections/Locations.astro";
import ContactNote from "../components/sections/ContactNote.astro";
import { allOutletsJsonLd, staticMeta } from "../lib/pageMeta";

const meta = staticMeta("en", Astro, {
	title: "Locations & contact — DAFU restaurants in Genting Highlands",
	description: "All our restaurants are in Genting Highlands for now, with Klang Valley outlets coming. Tap an address for directions.",
	crumb: "Find us",
	path: "/contact",
	jsonLd: await allOutletsJsonLd("en", Astro),
});
---

<Base lang="en" {...meta}>
	<PageHeader
		lang="en"
		heading="Find a DAFU restaurant"
		lede="All our restaurants are in Genting Highlands for now, with Klang Valley outlets coming. Tap an address for directions."
	/>
	<Locations lang="en" maps={true} dark={false} />
	<ContactNote
		lang="en"
		heading="Group enquiries"
		fallback="For group bookings, events, partnerships or media, message the restaurant directly."
	/>
</Base>
