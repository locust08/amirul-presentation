---
import Base from "../layouts/Base.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import RestaurantGrid from "../components/sections/RestaurantGrid.astro";
import SignatureStrip from "../components/sections/SignatureStrip.astro";
import StoryBand from "../components/sections/StoryBand.astro";
import LatestPromotions from "../components/sections/LatestPromotions.astro";
import Locations from "../components/sections/Locations.astro";
import { restaurantsListJsonLd } from "../lib/pageMeta";

const jsonLd = [await restaurantsListJsonLd("en", Astro)];
---

<Base
	lang="en"
	description="DAFU 大福 brings Hong Kong and Macau food to Genting Highlands: dai pai dong seafood, Cantonese congee, Macau bakes and a Lan Kwai Fong-style bar."
	jsonLd={jsonLd}
>
	<HomeHero
		lang="en"
		heading="Hong Kong and Macau flavours, up in Genting Highlands"
		lede="Wok-fired seafood, slow-cooked congee and a Lan Kwai Fong night out. Three DAFU restaurants, one short walk apart at the top of the hill."
		primaryLabel="Choose a restaurant"
		primaryHref="/restaurants"
		secondaryLabel="Get directions"
		secondaryHref="/contact"
	/>
	<RestaurantGrid
		lang="en"
		heading="Pick your table"
		lede="Every DAFU restaurant does one thing the way Hong Kong and Macau do it best."
	/>
	<SignatureStrip lang="en" heading="Dishes people come back for" perRestaurant={2} />
	<StoryBand
		lang="en"
		mark="大福"
		heading="Named for a dinner-table blessing"
		body="大福 — “great fortune” — is the wish you hear when glasses are raised across a Hong Kong or Macau table. We brought that table to Malaysia."
		buttonLabel="Read our story"
		buttonHref="/about"
	/>
	<LatestPromotions lang="en" heading="What’s on" linkLabel="See all promotions and news" limit={3} />
	<Locations lang="en" heading="Find us in Genting Highlands" linkLabel="All locations and contact details" area="Genting Highlands" />
</Base>
