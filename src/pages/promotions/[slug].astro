---
import Base from "../../layouts/Base.astro";
import PromotionDetail from "../../components/sections/PromotionDetail.astro";
import { getLocalizedEntry } from "../../lib/content";
import { promotionMeta } from "../../lib/pageMeta";

const entry = await getLocalizedEntry("promotions", Astro.params.slug ?? "", "en", Astro);
if (!entry) return Astro.rewrite("/404");
const meta = promotionMeta(entry, "en", Astro);
---

<Base lang="en" {...meta}>
	<PromotionDetail lang="en" entry={entry} />
</Base>
