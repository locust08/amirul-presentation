---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import PromotionList from "../../components/sections/PromotionList.astro";
import { staticMeta } from "../../lib/pageMeta";

const meta = staticMeta("en", Astro, {
	title: "Genting Highlands restaurant promotions & news",
	description: "Offers, new openings and announcements from DAFU restaurants.",
	crumb: "Promotions",
	path: "/promotions",
});
// Filtered views (?restaurant=…) duplicate this page, so keep them out of search results.
const filtered = Astro.url.searchParams.has("restaurant");
---

<Base lang="en" {...meta} noindex={filtered}>
	<PageHeader lang="en" heading="Promotions & news" lede="Offers, new openings and announcements from DAFU restaurants." />
	<PromotionList
		lang="en"
		allLabel="All DAFU restaurants"
		emptyText="No promotions right now. Check back soon, or visit one of our restaurants."
	/>
</Base>
