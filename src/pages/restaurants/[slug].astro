---
import Base from "../../layouts/Base.astro";
import RestaurantTheme from "../../components/sections/RestaurantTheme.astro";
import RestaurantHero from "../../components/sections/RestaurantHero.astro";
import RestaurantStory from "../../components/sections/RestaurantStory.astro";
import SignatureDishes from "../../components/sections/SignatureDishes.astro";
import MenuBoard from "../../components/sections/MenuBoard.astro";
import RestaurantGallery from "../../components/sections/RestaurantGallery.astro";
import RestaurantVisit from "../../components/sections/RestaurantVisit.astro";
import RestaurantPromotions from "../../components/sections/RestaurantPromotions.astro";
import OtherRestaurants from "../../components/sections/OtherRestaurants.astro";
import RestaurantActionBar from "../../components/sections/RestaurantActionBar.astro";
import { getLocalizedEntry } from "../../lib/content";
import { restaurantMeta } from "../../lib/pageMeta";

const entry = await getLocalizedEntry("restaurants", Astro.params.slug ?? "", "en", Astro);
if (!entry) return Astro.rewrite("/404");
const meta = restaurantMeta(entry, "en", Astro);
---

<Base lang="en" {...meta}>
	<RestaurantTheme entry={entry}>
		<RestaurantHero lang="en" entry={entry} menuLabel="Menu" />
		<RestaurantStory entry={entry} />
		<SignatureDishes entry={entry} heading="Signature dishes" />
		<MenuBoard
			lang="en"
			entry={entry}
			heading="Menu"
			note="Prices in Malaysian ringgit. Seasonal seafood is charged at the day’s price."
			pdfLabel="Download the full menu (PDF)"
		/>
		<RestaurantGallery entry={entry} heading="Inside the restaurant" />
		<RestaurantVisit lang="en" entry={entry} heading="Visit" maps={true} />
		<RestaurantPromotions lang="en" entry={entry} heading="Current promotions" limit={2} />
		<OtherRestaurants lang="en" entry={entry} heading="Also at DAFU" />
		<RestaurantActionBar lang="en" entry={entry} />
	</RestaurantTheme>
</Base>
