---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import RestaurantGrid from "../../components/sections/RestaurantGrid.astro";
import { restaurantsListJsonLd, staticMeta } from "../../lib/pageMeta";

const meta = staticMeta("en", Astro, {
	title: "Restaurants in Genting Highlands",
	description: "Hong Kong street-kitchen seafood, Cantonese congee with Macau bakes, and a Lan Kwai Fong-style bar — all in Genting Highlands.",
	crumb: "Restaurants",
	path: "/restaurants",
	jsonLd: [await restaurantsListJsonLd("en", Astro)],
});
---

<Base lang="en" {...meta}>
	<PageHeader
		lang="en"
		heading="Our restaurants"
		lede="Hong Kong street-kitchen seafood, Cantonese congee with Macau bakes, and a Lan Kwai Fong-style bar — all in Genting Highlands."
	/>
	<RestaurantGrid lang="en" cardHeadings="h2" emptyText="Restaurants will appear here once they are published in the admin." />
</Base>
