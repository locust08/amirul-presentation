---
// Any page written in the CMS under Pages (e.g. /zh/about).
import Base from "../../layouts/Base.astro";
import CmsPage from "../../components/sections/CmsPage.astro";
import { getLocalizedEntry } from "../../lib/content";
import { cmsPageMeta } from "../../lib/pageMeta";

// "home" and "contact" hold settings for those pages, not pages of their own.
const slug = Astro.params.slug ?? "";
const entry = ["home", "contact", "404"].includes(slug) ? null : await getLocalizedEntry("pages", slug, "zh", Astro);
if (!entry) return Astro.rewrite("/zh/404");
const meta = cmsPageMeta(entry, "zh", Astro);
---

<Base lang="zh" {...meta}>
	<CmsPage entry={entry} sign={slug === "about" ? "大福" : undefined} />
</Base>
