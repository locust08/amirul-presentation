---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import Locations from "../../components/sections/Locations.astro";
import ContactNote from "../../components/sections/ContactNote.astro";
import { allOutletsJsonLd, staticMeta } from "../../lib/pageMeta";

const meta = staticMeta("zh", Astro, {
	title: "云顶高原大福餐厅地点与联系方式",
	description: "目前所有餐厅位于云顶高原，巴生谷分店即将开业。点击地址即可查看路线。",
	crumb: "地点与联系",
	path: "/contact",
	jsonLd: await allOutletsJsonLd("zh", Astro),
});
---

<Base lang="zh" {...meta}>
	<PageHeader lang="zh" heading="找到大福餐厅" lede="目前所有餐厅位于云顶高原，巴生谷分店即将开业。点击地址即可查看路线。" />
	<Locations lang="zh" maps={true} dark={false} />
	<ContactNote lang="zh" heading="团体与合作查询" fallback="团体订座、活动、合作或媒体查询，请直接联系相关餐厅。" />
</Base>
