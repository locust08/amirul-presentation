---
import Base from "../../layouts/Base.astro";
import HomeHero from "../../components/sections/HomeHero.astro";
import RestaurantGrid from "../../components/sections/RestaurantGrid.astro";
import SignatureStrip from "../../components/sections/SignatureStrip.astro";
import StoryBand from "../../components/sections/StoryBand.astro";
import LatestPromotions from "../../components/sections/LatestPromotions.astro";
import Locations from "../../components/sections/Locations.astro";
import { restaurantsListJsonLd } from "../../lib/pageMeta";

const jsonLd = [await restaurantsListJsonLd("zh", Astro)];
---

<Base
	lang="zh"
	description="大福 DAFU 把港澳美食带到云顶高原：大排档海鲜、广式粥品、澳门烘焙，以及兰桂坊风格酒吧。"
	jsonLd={jsonLd}
>
	<HomeHero
		lang="zh"
		heading="港澳好味道，就在云顶高原"
		lede="猛火海鲜、慢熬靓粥、兰桂坊之夜。三家大福餐厅，就在山顶，步行即达。"
		primaryLabel="选择餐厅"
		primaryHref="/restaurants"
		secondaryLabel="查看路线"
		secondaryHref="/contact"
	/>
	<RestaurantGrid lang="zh" heading="今天吃哪家？" lede="每家大福餐厅，都以港澳最地道的方式，做好一件事。" />
	<SignatureStrip lang="zh" heading="回头客必点" perRestaurant={2} />
	<StoryBand
		lang="zh"
		mark="大福"
		heading="以饭桌上的祝福为名"
		body="“大福”是港澳饭桌举杯时最常听到的祝愿。我们把这张饭桌搬到了马来西亚。"
		buttonLabel="了解我们的故事"
		buttonHref="/about"
	/>
	<LatestPromotions lang="zh" heading="最新动态" linkLabel="查看全部优惠与资讯" limit={3} />
	<Locations lang="zh" heading="云顶高原分店" linkLabel="全部地点与联系方式" area="Genting Highlands" />
</Base>
