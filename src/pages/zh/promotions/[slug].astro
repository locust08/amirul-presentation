---
import Base from "../../../layouts/Base.astro";
import PromotionDetail from "../../../components/sections/PromotionDetail.astro";
import { getLocalizedEntry } from "../../../lib/content";
import { promotionMeta } from "../../../lib/pageMeta";

const entry = await getLocalizedEntry("promotions", Astro.params.slug ?? "", "zh", Astro);
if (!entry) return Astro.rewrite("/zh/404");
const meta = promotionMeta(entry, "zh", Astro);
---

<Base lang="zh" {...meta}>
	<PromotionDetail lang="zh" entry={entry} />
</Base>
