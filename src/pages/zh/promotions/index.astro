---
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/sections/PageHeader.astro";
import PromotionList from "../../../components/sections/PromotionList.astro";
import { staticMeta } from "../../../lib/pageMeta";

const meta = staticMeta("zh", Astro, {
	title: "云顶高原餐厅优惠与最新资讯",
	description: "大福各餐厅的优惠、新店开幕与最新消息。",
	crumb: "优惠与资讯",
	path: "/promotions",
});
// Filtered views (?restaurant=…) duplicate this page, so keep them out of search results.
const filtered = Astro.url.searchParams.has("restaurant");
---

<Base lang="zh" {...meta} noindex={filtered}>
	<PageHeader lang="zh" heading="优惠与资讯" lede="大福各餐厅的优惠、新店开幕与最新消息。" />
	<PromotionList lang="zh" allLabel="大福全线餐厅" emptyText="目前没有优惠活动，欢迎稍后再来看看，或直接光临我们的餐厅。" />
</Base>
