---
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/sections/PageHeader.astro";
import RestaurantGrid from "../../../components/sections/RestaurantGrid.astro";
import { restaurantsListJsonLd, staticMeta } from "../../../lib/pageMeta";

const meta = staticMeta("zh", Astro, {
	title: "云顶高原餐厅推荐｜大福旗下餐厅",
	description: "香港大排档海鲜、广式粥品配澳门烘焙，以及兰桂坊风格酒吧——都在云顶高原。",
	crumb: "餐厅",
	path: "/restaurants",
	jsonLd: [await restaurantsListJsonLd("zh", Astro)],
});
---

<Base lang="zh" {...meta}>
	<PageHeader lang="zh" heading="我们的餐厅" lede="香港大排档海鲜、广式粥品配澳门烘焙，以及兰桂坊风格酒吧——都在云顶高原。" />
	<RestaurantGrid lang="zh" cardHeadings="h2" emptyText="餐厅在后台发布后会显示在这里。" />
</Base>
