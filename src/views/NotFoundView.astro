---
import Base from "../layouts/Base.astro";
import RestaurantCard from "../components/RestaurantCard.astro";
import { getRestaurants } from "../lib/content";
import { localePath, useTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const restaurants = await getRestaurants(lang, Astro);
---

<Base lang={lang} title={t("notFound.title")} noindex alternates={false}>
	<section class="section">
		<div class="wrap">
			<h1>{t("notFound.title")}</h1>
			<p class="lede">{t("notFound.body")}</p>
			<a class="btn btn-red" href={localePath(lang, "/")}>{t("notFound.home")}</a>
			<div class="cards">
				{restaurants.map((r) => <RestaurantCard entry={r} lang={lang} headingLevel="h2" />)}
			</div>
		</div>
	</section>
</Base>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: var(--space-3);
		margin-top: var(--space-5);
	}
</style>
