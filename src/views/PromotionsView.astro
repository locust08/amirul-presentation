---
import Base from "../layouts/Base.astro";
import PromoCard from "../components/PromoCard.astro";
import { getPromotions, getRestaurants, restaurantLookup } from "../lib/content";
import { breadcrumbJsonLd } from "../lib/seo";
import { localePath, useTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const origin = (Astro.site ?? Astro.url).origin;

const [promotions, restaurants] = await Promise.all([getPromotions(lang, Astro), getRestaurants(lang, Astro)]);
const lookup = restaurantLookup(restaurants);

// Optional filter: ?restaurant=dafu-congee
const filter = Astro.url.searchParams.get("restaurant");
const shown = filter && lookup.has(filter)
	? promotions.filter((p) => p.data.restaurant === filter || p.data.restaurant === "all")
	: promotions;

const title = lang === "zh" ? "云顶高原餐厅优惠与最新资讯" : "Genting Highlands restaurant promotions & news";
const filters = [{ slug: "", label: t("promotions.allRestaurants") }, ...restaurants.map((r) => ({ slug: r.id, label: r.data.name }))];
---

<Base
	lang={lang}
	title={title}
	description={t("promotions.lede")}
	noindex={!!filter}
	jsonLd={[
		breadcrumbJsonLd(
			[
				{ name: t("breadcrumb.home"), path: localePath(lang, "/") },
				{ name: t("nav.promotions"), path: localePath(lang, "/promotions") },
			],
			origin,
		),
	]}
>
	<header class="page-head on-jade">
		<div class="wrap">
			<h1>{t("promotions.heading")}</h1>
			<p class="lede">{t("promotions.lede")}</p>
		</div>
	</header>

	<section class="section">
		<div class="wrap">
			{
				restaurants.length > 1 && (
					<nav class="filters" aria-label={t("nav.restaurants")}>
						{filters.map((f) => {
							const active = (f.slug || null) === (filter && lookup.has(filter) ? filter : null);
							const href = f.slug ? `${localePath(lang, "/promotions")}?restaurant=${f.slug}` : localePath(lang, "/promotions");
							return (
								<a href={href} aria-current={active ? "page" : undefined}>
									{f.label}
								</a>
							);
						})}
					</nav>
				)
			}

			{
				shown.length === 0 ? (
					<p class="empty">{t("promotions.empty")}</p>
				) : (
					<div class="list">
						{shown.map((p) => (
							<PromoCard entry={p} lang={lang} restaurants={lookup} layout="row" />
						))}
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.page-head {
		padding-block: var(--space-5) var(--space-4);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: var(--space-4);
	}

	.filters a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 1rem;
		border: 2px solid var(--line);
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		background: var(--white);
	}

	.filters a[aria-current="page"] {
		background: var(--jade);
		border-color: var(--jade);
		color: var(--white);
	}

	.list {
		display: grid;
		gap: var(--space-4);
		max-width: 980px;
	}

	.empty {
		font-size: var(--step-1);
	}
</style>
