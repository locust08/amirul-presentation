---
import Base from "../layouts/Base.astro";
import RestaurantCard from "../components/RestaurantCard.astro";
import { getRestaurants } from "../lib/content";
import { breadcrumbJsonLd, itemListJsonLd } from "../lib/seo";
import { localePath, useTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const origin = (Astro.site ?? Astro.url).origin;
const restaurants = await getRestaurants(lang, Astro);

const title = lang === "zh" ? "云顶高原餐厅推荐｜大福旗下餐厅" : "Restaurants in Genting Highlands";
---

<Base
	lang={lang}
	title={title}
	description={t("restaurants.lede")}
	jsonLd={[
		itemListJsonLd(restaurants, lang, origin),
		breadcrumbJsonLd(
			[
				{ name: t("breadcrumb.home"), path: localePath(lang, "/") },
				{ name: t("nav.restaurants"), path: localePath(lang, "/restaurants") },
			],
			origin,
		),
	]}
>
	<header class="page-head on-jade">
		<div class="wrap">
			<h1>{t("restaurants.heading")}</h1>
			<p class="lede">{t("restaurants.lede")}</p>
		</div>
	</header>

	<section class="section">
		<div class="wrap">
			{
				restaurants.length === 0 ? (
					<p>{t("restaurants.empty")}</p>
				) : (
					<div class="cards">
						{restaurants.map((r) => (
							<RestaurantCard entry={r} lang={lang} headingLevel="h2" />
						))}
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.page-head {
		padding-block: var(--space-5) var(--space-4);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: var(--space-3);
	}
</style>
